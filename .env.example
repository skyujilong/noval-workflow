# Copy this file to .env.local and fill in your values
# 火山引擎 ARK (OpenAI-compatible API)
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=doubao-seed-2.0-lite

# Batch size: how many chapter titles are generated per batch
NOVEL_BATCH_SIZE=5

# ── 章节规划(chapter_plan)——弧线大纲之前的远端锚点滚动窗口 ────────────
# 一次向前规划的章数(远端锚点覆盖范围)。默认 40,建议 30~50;必须 >= NOVEL_BATCH_SIZE。
NOVEL_CHAPTER_PLAN_WINDOW=40
# 滚动步长:每写完 K 章触发一次重规划。默认 10,应为 NOVEL_BATCH_SIZE 的倍数以对齐批边界。
NOVEL_CHAPTER_PLAN_STRIDE=10
# 功能开关(v1 保底):false 时全链路跳过 chapter_plan,退化为旧行为(弧线大纲直接接整书大纲)。默认 true。
NOVEL_CHAPTER_PLAN_ENABLED=true

# 设定一致性总审的重审轮数上限（达此轮数强制放行冻结，防反复重审卡死）。默认 3。
CONSISTENCY_MAX_AUDIT_ROUNDS=3

# ── 章末精简（伏笔台账 + 实体卡库）节流 ────────────────────────────────────
# 精简 = LLM 分析整库 + 勾选删库，默认每章都跑（自动模式尤其无脑）。此步长节流为
# 「每 N 章执行一次」：仅刚写完的章号是 N 的整数倍时才精简，否则直接跳过（不弹中断、不调 LLM）。
# 伏笔台账与实体卡库共用此步长。N=3（默认）→ 第 3/6/9… 章末各一次；N=1 → 每章都精简（旧行为）。
NOVEL_PRUNE_STRIDE=3

# 关闭 LLM 自审的 review_type 清单（逗号分隔，覆盖语义：设置即完全替换默认，需列全）。
# 留空/不设 = 用默认集合（titles,scene_beats,entity_cards,foreshadowing,phase_summary,entity_discover）。
# 这些「结构化数据维护」类跳过创作级自审，省调用 + 免自审挑刺触发的连锁重写。
# NOVEL_SELF_REVIEW_DISABLED_TYPES=titles,scene_beats,entity_cards,foreshadowing,phase_summary,entity_discover

# ── 端口配置（多 worktree 并行开发时可修改，避免端口冲突）─────────────
# 后端 langgraph dev 端口（dev-backend.sh 读取，默认 28123）
LANGGRAPH_PORT=28123

# 前端 Vite dev server 端口（dev-frontend.sh + vite.config.ts 读取，默认 15173）
VITE_PORT=15173

# 后端 API 完整地址（前端 langgraph.ts + vite.config.ts proxy 读取）。
# 如 LANGGRAPH_PORT 非默认，需同步修改此值，或改为显式地址如 http://127.0.0.1:28124。
VITE_LANGGRAPH_API_URL=http://127.0.0.1:${LANGGRAPH_PORT}

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
